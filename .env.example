# Copie ce fichier en ".env" et remplis tes propres valeurs. Ne le partage jamais.

# Chaîne aléatoire longue (24 caractères minimum) pour signer les sessions.
# Génère-en une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=a4f89d1b6e42c3d8e901f4

# Compte administrateur de la boutique (créé au premier démarrage).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Production : active les cookies sécurisés (HTTPS obligatoire) et les contrôles de démarrage.
# NODE_ENV=production

# Dossier de stockage persistant (base de données + photos des produits).
# En ligne, pointe-le vers un volume persistant, par exemple /data
# DATA_DIR=/data

PORT=3000
