<%- include('../partials/shop_top') %>
<div class="sh-wrap" style="max-width:720px">
  <div class="sh-ok">
    <svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="26" fill="none" stroke="#1e7a46" stroke-width="2.5"/><path d="M28 41l8 8 16-17" fill="none" stroke="#1e7a46" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h1 class="sh-h2" style="font-size:24px; margin:12px 0 4px"><%= t('conf_thanks', { name: order.client.prenom }) %></h1>
    <p style="color:var(--muted); margin:0"><%- th('conf_contact', { tel: order.client.telephone }) %></p>
    <div class="sh-ref" dir="ltr" aria-label="<%= t('conf_ref_aria') %>"><%= order.ref %></div>
    <p style="font-size:12px; color:var(--muted); margin:0 0 20px"><%= t('conf_keep') %></p>
  </div>
  <div class="sh-box" style="margin-bottom:16px">
    <h2 class="sh-h2"><%= t('recap') %></h2>
    <% order.lignes.forEach(l => { %><div class="sh-sum"><span><%= l.qte %> × <%= (lang === 'ar' && l.nomAr) || l.nom %></span><span><%= mad(l.prix * l.qte) %></span></div><% }) %>
    <div class="sh-sum"><span><%= t('delivery') %></span><span><%= order.fraisLivraison === 0 ? t('free') : mad(order.fraisLivraison) %></span></div>
    <div class="sh-sum total"><span><%= t('total_cod') %></span><b><%= mad(order.total) %></b></div>
    <p style="font-size:13px; color:var(--muted); margin:14px 0 0"><b style="font-weight:400; color:var(--text)"><%= t('deliver_to') %></b> <%= order.client.prenom %> <%= order.client.nom %>, <%= order.client.adresse %>, <%= order.client.ville %></p>
  </div>
  <% if (inline) { %><div class="sh-bn-wrap" style="margin-top:0"><%- include('../partials/banner_inline', { b: inline }) %></div><% } %>
  <div class="actions-row" style="justify-content:center; margin-bottom:44px">
    <a class="sh-btn" href="/suivi"><%= t('track_btn') %></a>
    <a class="sh-btn ghost" href="/"><%= t('continue_shopping') %></a>
  </div>
</div>
<%- include('../partials/shop_bottom') %>
