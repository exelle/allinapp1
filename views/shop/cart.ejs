<%- include('../partials/shop_top') %>
<div class="sh-wrap">
  <h1 class="sh-h2" style="margin-top:26px; font-size:22px"><%= t('cart_h1') %></h1>
  <% c.notices.forEach(n => { %><div class="alert"><%= n %></div><% }) %>
  <% if (!c.lines.length) { %>
    <div class="sh-box sh-empty" style="margin-bottom:40px"><%= t('cart_empty') %><br><br><a class="sh-btn" href="/"><%= t('discover') %></a></div>
  <% } else { %>
  <div class="sh-layout">
    <div class="sh-box">
      <form method="POST" action="/panier/maj">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <% c.lines.forEach(l => { %>
        <div class="sh-line">
          <% if (l.product.thumb) { %><img src="<%= l.product.thumb %>" alt="" width="64" height="64"><% } else { %><div class="ph"></div><% } %>
          <div class="t"><a href="/produit/<%= l.product.id %>"><%= pn(l.product) %></a><small><%= t('unit_price', { price: mad(l.product.prix) }) %></small></div>
          <div class="sh-qty" dir="ltr"><button type="button" data-step="-1" aria-label="<%= t('qty_minus') %>">−</button><input type="number" name="q_<%= l.product.id %>" value="<%= l.qte %>" min="0" max="20" data-autosubmit aria-label="<%= t('qty_of', { name: pn(l.product) }) %>"><button type="button" data-step="1" aria-label="<%= t('qty_plus') %>">+</button></div>
          <div style="width:84px; text-align:end"><%= mad(l.total) %></div>
          <button type="submit" form="rm_<%= l.product.id %>" class="ghost sh-x" aria-label="<%= t('remove', { name: pn(l.product) }) %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <% }) %>
        <noscript><button type="submit" class="sh-btn ghost" style="margin-top:10px"><%= t('update_qty') %></button></noscript>
      </form>
      <% c.lines.forEach(l => { %>
      <form id="rm_<%= l.product.id %>" method="POST" action="/panier/retirer"><input type="hidden" name="_csrf" value="<%= csrf() %>"><input type="hidden" name="productId" value="<%= l.product.id %>"></form>
      <% }) %>
    </div>
    <aside class="sh-box">
      <h2 class="sh-h2"><%= t('summary') %></h2>
      <div class="sh-sum"><span><%= t('subtotal') %></span><span><%= mad(c.sousTotal) %></span></div>
      <div class="sh-sum"><span><%= t('delivery') %></span><span><%= c.frais === 0 ? t('free') : mad(c.frais) %></span></div>
      <% if (c.resteGratuit > 0) { %>
      <div class="sh-free"><%- th('free_left', { amount: mad(c.resteGratuit) }) %><i><b style="width:<%= Math.min(100, Math.round(c.sousTotal / settings.livraisonGratuiteDes * 100)) %>%"></b></i></div>
      <% } %>
      <div class="sh-sum total"><span><%= t('total_cod') %></span><b><%= mad(c.total) %></b></div>
      <a class="sh-btn block" style="margin-top:14px" href="/commande"><%= t('checkout_btn') %></a>
      <a class="sh-btn ghost block" style="margin-top:8px" href="/"><%= t('continue_shopping') %></a>
    </aside>
  </div>
  <% if (inline) { %><div class="sh-bn-wrap" style="margin-top:0"><%- include('../partials/banner_inline', { b: inline }) %></div><% } %>
  <% } %>
</div>
<%- include('../partials/shop_bottom') %>
