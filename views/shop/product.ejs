<%- include('../partials/shop_top') %>
<div class="sh-wrap">
  <nav class="sh-crumbs" aria-label="Fil d’Ariane"><a href="/">Boutique</a><% if (p.categorie) { %> › <a href="/?cat=<%= encodeURIComponent(p.categorie) %>"><%= p.categorie %></a><% } %> › <%= p.nom %></nav>
  <div class="sh-detail">
    <div class="sh-ph">
      <% if (p.photo) { %><img src="<%= p.photo %>" alt="<%= p.nom %>" width="1000" height="1000"><% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg><% } %>
      <% if (soldOut) { %><span class="sh-tag out">Épuisé</span><% } else if (p.ancienPrix) { %><span class="sh-tag">-<%= Math.round((1 - p.prix / p.ancienPrix) * 100) %>%</span><% } %>
    </div>
    <div>
      <% if (p.categorie) { %><span class="sh-cat"><%= p.categorie %></span><% } %>
      <h1><%= p.nom %></h1>
      <div class="sh-bigprice"><%= fmt.mad(p.prix) %><% if (p.ancienPrix) { %><s><%= fmt.mad(p.ancienPrix) %></s><span class="sh-save">Vous économisez <%= fmt.mad(p.ancienPrix - p.prix) %></span><% } %></div>
      <% if (soldOut) { %><p class="sh-stock">Ce produit est momentanément épuisé.</p>
      <% } else if (p.stock !== null && p.stock !== undefined && p.stock <= 5) { %><p class="sh-stock">Plus que <%= p.stock %> en stock</p><% } %>
      <% if (p.description) { %><div class="sh-desc"><%= p.description %></div><% } %>
      <% if (!soldOut) { %>
      <form method="POST" action="/panier/ajouter">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <input type="hidden" name="productId" value="<%= p.id %>">
        <div class="sh-buy">
          <div class="sh-qty"><button type="button" data-step="-1" aria-label="Diminuer la quantité">−</button><input type="number" name="qte" value="1" min="1" max="<%= maxQty %>" aria-label="Quantité"><button type="button" data-step="1" aria-label="Augmenter la quantité">+</button></div>
          <button type="submit" class="sh-btn" style="flex:1">Ajouter au panier</button>
        </div>
        <button type="submit" name="next" value="commande" class="sh-btn ghost block">Commander maintenant</button>
      </form>
      <% } %>
      <div class="sh-reassure" style="margin-top:18px"><div>Paiement à la livraison</div><div>Aucun compte à créer</div><div>Suivi de commande en ligne</div></div>
    </div>
  </div>
  <% if (others.length) { %>
    <h2 class="sh-h2">Vous aimerez aussi</h2>
    <div class="sh-grid" style="margin-bottom:40px"><% others.forEach(o => { %><%- include('../partials/product_card', { p: o }) %><% }) %></div>
  <% } %>
</div>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'Product', name: p.nom, description: p.description || p.nom, image: p.photo ? baseUrl + p.photo : undefined, offers: { '@type': 'Offer', priceCurrency: 'MAD', price: p.prix, availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock' } }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/shop_bottom') %>
