<%- include('../partials/shop_top') %>
<% const esc = (x) => String(x).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
   const v = (x) => x ? esc(x) : '<span class="todo">[à compléter]</span>';
   const todo = (t) => '<span class="todo">[à préciser : ' + t + ']</span>'; %>
<div class="sh-wrap sh-legal" style="max-width:780px; padding-bottom:40px">
  <h1><%= title %></h1>
  <%- include('legal/' + slug, { v, todo, s }) %>
  <p style="font-size:12px; color:var(--muted); margin-top:28px">Dernière mise à jour : <%= fmt.date(new Date()) %></p>
</div>
<%- include('../partials/shop_bottom') %>
