<%- include('../partials/shop_top') %>
<% const esc = (x) => String(x).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
   const AR = lang === 'ar';
   const v = (x) => x ? esc(x) : '<span class="todo">' + (AR ? '[يجب استكماله]' : '[à compléter]') + '</span>';
   const todo = (t) => '<span class="todo">' + (AR ? '[يجب تحديده: ' : '[à préciser : ') + t + ']</span>'; %>
<div class="sh-wrap sh-legal" style="max-width:780px; padding-bottom:40px">
  <h1><%= title %></h1>
  <%- include('legal/' + (AR ? 'ar/' : '') + slug, { v, todo, s }) %>
  <p style="font-size:12px; color:var(--muted); margin-top:28px"><%= t('legal_updated', { date: dd(new Date()) }) %></p>
</div>
<%- include('../partials/shop_bottom') %>
