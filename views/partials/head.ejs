<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title ? title + ' — ' : '' %>All in app</title>
<% if (locals.description) { %><meta name="description" content="<%= description %>">
<meta property="og:description" content="<%= description %>"><% } %>
<meta property="og:site_name" content="All in app">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= locals.title || 'All in app' %>">
<% if (locals.ogImage) { %><meta property="og:image" content="<%= baseUrl + ogImage %>"><% } %>
<% if (locals.noindex) { %><meta name="robots" content="noindex,nofollow"><% } %>
<meta name="theme-color" content="#6232AF">
<link rel="icon" href="/logo.svg">
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="All in app">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400&display=swap" rel="stylesheet">
<% if (locals.lang === 'ar' || locals.langChosen === false) { %><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400&display=swap" rel="stylesheet"><% } %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/shop.css">
