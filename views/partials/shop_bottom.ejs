      <li><a href="/page/confidentialite"><%= t('foot_privacy') %></a></li>
    </ul></div>
  </div>
  <div class="copy">© <%= new Date().getFullYear() %> <%= settings.raisonSociale %> — <%= t('foot_rights') %></div>
</div></footer>
