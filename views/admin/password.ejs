<%- include('../partials/admin_top') %>
<div class="card" style="max-width:460px"><h2>Changer mon mot de passe</h2>
  <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/admin/mot-de-passe">
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <div class="field"><label for="a">Mot de passe actuel</label><input id="a" type="password" name="current" required autocomplete="current-password"></div>
    <div class="field"><label for="b">Nouveau mot de passe (10 caractères minimum)</label><input id="b" type="password" name="next" minlength="10" required autocomplete="new-password"></div>
    <div class="field"><label for="c">Confirmer le nouveau mot de passe</label><input id="c" type="password" name="confirm" minlength="10" required autocomplete="new-password"></div>
    <button type="submit">Mettre à jour</button>
  </form>
</div>
<%- include('../partials/admin_bottom') %>
