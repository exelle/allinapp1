<%- include('../partials/admin_top') %>
<div class="card">
  <div class="actions-row" style="justify-content:space-between; margin-bottom:6px"><h2 style="margin:0">Catalogue (<%= products.length %>)</h2><a class="btn" href="/admin/produits/nouveau">+ Nouveau produit</a></div>
  <% if (!products.length) { %><div class="empty">Aucun produit pour le moment.</div><% } else { %>
  <table><thead><tr><th></th><th>Produit</th><th class="num">Prix</th><th class="num">Stock</th><th>Visibilité</th><th></th></tr></thead><tbody>
    <% products.forEach(p => { %><tr>
      <td style="width:56px"><% if (p.thumb) { %><img class="thumb" src="<%= p.thumb %>" alt=""><% } else { %><div class="thumb"></div><% } %></td>
      <td><%= p.nom %><br><small style="color:var(--muted)"><%= catLabel(p.categorie) %><%= p.nomAr ? ' · عربي ✓' : '' %></small></td>
      <td class="num"><%= fmt.mad(p.prix) %></td>
      <td class="num"><%= p.stock === null || p.stock === undefined ? 'Illimité' : p.stock %></td>
      <td><span class="pill <%= p.actif ? 'livree' : 'retournee' %>"><%= p.actif ? 'En ligne' : 'Masqué' %></span></td>
      <td style="white-space:nowrap"><a class="ghost btn" style="padding:4px 10px; font-size:12px" href="/admin/produits/<%= p.id %>">Modifier</a>
        <form class="inline" method="POST" action="/admin/produits/<%= p.id %>/supprimer" data-confirm="Supprimer ce produit définitivement ?"><input type="hidden" name="_csrf" value="<%= csrf() %>"><button type="submit" class="secondary" style="padding:4px 10px; font-size:12px">Supprimer</button></form></td>
    </tr><% }) %>
  </tbody></table>
  <% } %>
</div>
<%- include('../partials/admin_bottom') %>
